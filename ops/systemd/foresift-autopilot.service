# Foresift autopilot — thin supervisory loop over the Archon CLI.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/foresift-autopilot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   loginctl enable-linger $USER        # keep running after logout
#   systemctl --user enable --now foresift-autopilot.service
#
# Status / logs:
#   pnpm autopilot:status               # roadmap + milestone + run state
#   journalctl --user -u foresift-autopilot.service -f
#
# The supervisor is deliberately thin: it only starts/stops/resumes Archon
# workflow runs and commits version-controlled implementation state. All
# deterministic policy lives in version-controlled automation and Archon
# workflows. Codex is the default product writer, AGY owns task tests, and
# Claude is retained for incidents and the explicit CLAUDE_AGY fallback.

[Unit]
Description=Foresift autonomous development autopilot
After=network-online.target archon-dashboard.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/foresift
ExecStart=/home/minhquan_eth/.nvm/versions/node/v24.19.0/bin/node /home/minhquan_eth/foresift/scripts/automation/foresift-autopilot.mjs
Restart=on-failure
RestartSec=30
# Detached Archon workflow runs are children of this service's cgroup. The
# default KillMode=control-group would SIGTERM them on every stop/restart,
# orphaning their run rows as stuck "running". KillMode=process keeps them
# alive across supervisor restarts; the next supervisor instance re-adopts
# them from the runtime state file and the Archon runs table.
KillMode=process
Environment=PATH=/home/minhquan_eth/.nvm/versions/node/v24.19.0/bin:/home/minhquan_eth/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/minhquan_eth
# Default execution profile is intentionally NOT an environment variable here:
# config/foresift-execution.json is the version-controlled authority. Operators
# may add FORESIFT_EXECUTION_PROFILE=CLAUDE_AGY in a temporary systemd drop-in.

[Install]
WantedBy=default.target
