{
  "name": "foresift",
  "version": "0.0.0",
  "private": true,
  "description": "Foresift — greenfield implementation of the Crypto Intelligence Agent Gateway product contract (spec-driven, autonomously developed).",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "spec:verify": "node scripts/spec-verify.mjs",
    "foresift:gate": "node scripts/automation/foresift-gate.mjs",
    "autopilot:status": "node scripts/automation/foresift-autopilot.mjs --status",
    "autopilot:selftest": "bash scripts/automation/supervisor-selftest.sh",
    "autopilot:recover": "node scripts/automation/foresift-autopilot.mjs --recover-fatal",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm spec:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
