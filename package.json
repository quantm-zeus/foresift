{
  "name": "foresift",
  "version": "0.0.0",
  "private": true,
  "description": "Foresift — greenfield implementation of the Crypto Intelligence Agent Gateway product contract (spec-driven, autonomously developed).",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "spec:verify": "node scripts/spec-verify.mjs",
    "foresift:gate": "node scripts/automation/foresift-gate.mjs",
    "wp:profile": "node scripts/automation/work-package-throughput-profile.mjs",
    "wp:checkpoint": "node scripts/automation/package-checkpoint.mjs",
    "wp:fast-verify": "node scripts/automation/package-fast-verify.mjs",
    "wp:full-gate": "node scripts/automation/package-full-gate.mjs",
    "wp:land": "node scripts/automation/package-land.mjs",
    "wp:dedupe-report": "node scripts/automation/verify-dedupe.mjs",
    "autopilot:status": "node scripts/automation/foresift-autopilot.mjs --status",
    "autopilot:selftest": "bash scripts/automation/supervisor-selftest.sh",
    "autopilot:recover": "node scripts/automation/foresift-autopilot.mjs --recover-fatal",
    "autopilot:restart-package": "node scripts/automation/foresift-autopilot.mjs --restart-package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/automation/test-authority.mjs",
    "test:unit": "node scripts/automation/bun-test-coordinator.mjs --manifest evidence/bun-migration/bun-migration-manifest.json --workload PURE",
    "test:pure": "node scripts/automation/bun-test-coordinator.mjs --manifest evidence/bun-migration/bun-migration-manifest.json --workload PURE",
    "test:process-meta": "node scripts/automation/bun-test-coordinator.mjs --manifest evidence/bun-migration/bun-migration-manifest.json --workload PROCESS,META_GATE",
    "test:pglite": "node scripts/automation/bun-test-coordinator.mjs --manifest evidence/bun-migration/bun-migration-manifest.json --workload DATABASE_PGLITE",
    "test:integration": "node scripts/automation/bun-test-coordinator.mjs --manifest evidence/bun-migration/bun-migration-manifest.json --workload PROCESS,DATABASE_PGLITE,META_GATE",
    "test:watch": "bun test --watch",
    "test:node-compat": "node scripts/automation/node-runtime-compat.mjs",
    "test:state-control-plane": "bun test tests/automation/ci-authority-hardening.spec.ts tests/automation/state-landing-lifecycle.spec.ts tests/automation/package-launch-intent.spec.ts tests/automation/ci-repair-lifecycle.spec.ts tests/automation/ci-diff-classifier.spec.ts",
    "verify": "pnpm spec:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:node-compat"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@foresift/domain": "workspace:*",
    "@foresift/evidence": "workspace:*",
    "@foresift/object-store": "workspace:*",
    "@foresift/persistence": "workspace:*",
    "@foresift/provider-lifecycle": "workspace:*",
    "@foresift/security": "workspace:*",
    "@foresift/shared-schemas": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
