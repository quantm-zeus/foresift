{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "alert",
  "description": "Alert lifecycle telemetry contracts: per-class classification decided/suppressed, each §26.3 confirmed-opportunity gate passed/refused, class-templated content rendered or refused by the language law, SOCIAL_UNAVAILABLE observed as unknown coverage, fingerprint/cooldown repeat suppression, prior-alert update committed/deduplicated/expired, and per-class metric observations with an explicit numerator, denominator, and sample size. Field lists mirror packages/shared-schemas/src/alert.ts authoritative schemas; every event carries the critical-metadata recovery tier.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring is deferred to G2 observability. Field lists mirror packages/shared-schemas/src/alert.ts authoritative schemas.",
  "requirementsCovered": [
    "FR-ALERT-001",
    "FR-ALERT-002",
    "FR-ALERT-003",
    "FR-ALERT-004",
    "FR-ALERT-005"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
