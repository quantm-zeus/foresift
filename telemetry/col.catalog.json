{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "col",
  "description": "Declarative first-party collector contracts projected from the authoritative shared schemas. Catalog metadata contains no credentials, tokens, signed URLs, or secret material.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring is deferred to G2 observability.",
  "requirementsCovered": [
    "FR-COL-001",
    "FR-COL-002",
    "FR-COL-003",
    "FR-COL-004",
    "FR-COL-005",
    "FR-COL-006",
    "FR-COL-007",
    "FR-COL-008",
    "FR-COL-009",
    "FR-COL-010",
    "FR-COL-011",
    "FR-COL-012"
  ],
  "recoveryDataClass": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
  "events": [
    {
      "name": "scope_activated",
      "requirementRefs": ["FR-COL-001", "FR-COL-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "scopeId", "type": "string", "required": true },
        { "name": "chainId", "type": "string", "required": true },
        { "name": "programId", "type": "string", "required": true },
        { "name": "programVersion", "type": "string", "required": true },
        { "name": "accountLayoutVersion", "type": "string", "required": true },
        { "name": "supportedEventFamilies", "type": "array<string>", "required": true },
        { "name": "coverageStartSlot", "type": "string<digits>", "required": true },
        { "name": "coverageStartTime", "type": "string<utc-timestamp>", "required": true },
        { "name": "finalityPolicy", "type": "string(confirmed|finalized)", "required": true },
        { "name": "decoderVersion", "type": "string", "required": true },
        {
          "name": "quotaStreamedByteEnvelope",
          "type": "object{maxBytesPerSec,maxEventsPerSec}",
          "required": true
        },
        { "name": "maximumLagSlots", "type": "integer", "required": true },
        { "name": "maximumGapAgeSeconds", "type": "integer", "required": true },
        { "name": "rightsPolicy", "type": "string", "required": true }
      ]
    },
    {
      "name": "stream_receipt_committed",
      "requirementRefs": ["FR-COL-003", "FR-COL-006"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "recordId", "type": "string", "required": true },
        { "name": "endpoint", "type": "string", "required": true },
        { "name": "subscriptionFilterVersion", "type": "string", "required": true },
        { "name": "connectionGeneration", "type": "integer", "required": true },
        { "name": "slot", "type": "string<digits>", "required": true },
        { "name": "blockHash", "type": "string", "required": true },
        { "name": "transactionSignature", "type": "string", "required": true },
        { "name": "instructionIndex", "type": "integer", "required": true },
        { "name": "logIndex", "type": "integer", "required": false },
        { "name": "accountCoordinates", "type": "array<string>", "required": true },
        { "name": "receivedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "ingestedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "finality", "type": "string(processed|confirmed|finalized)", "required": true },
        { "name": "rawArtifactHash", "type": "string<sha256>", "required": true },
        { "name": "decoderVersion", "type": "string", "required": true },
        { "name": "rightsPolicy", "type": "string", "required": true },
        { "name": "normalizedEventHash", "type": "string<sha256>", "required": true },
        { "name": "eventType", "type": "string", "required": true },
        { "name": "payload", "type": "object", "required": true }
      ]
    },
    {
      "name": "checkpoint_advanced",
      "requirementRefs": ["FR-COL-004", "FR-COL-009"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "shardId", "type": "string", "required": true },
        { "name": "fencingToken", "type": "string<digits>", "required": true },
        { "name": "cursorPosition", "type": "string<digits>", "required": true },
        { "name": "updatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "gap_registered",
      "requirementRefs": ["FR-COL-004"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "gapId", "type": "string", "required": true },
        { "name": "shardId", "type": "string", "required": true },
        { "name": "gapStartSlot", "type": "string<digits>", "required": true },
        { "name": "gapEndSlot", "type": "string<digits>", "required": true },
        { "name": "reason", "type": "string", "required": true },
        {
          "name": "recoveryStatus",
          "type": "string(UNRECOVERED|RECOVERING|RECOVERED|DECLARED_UNRECOVERABLE)",
          "required": true
        },
        { "name": "registeredAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "resolvedAt", "type": "string<utc-timestamp>|null", "required": true }
      ]
    },
    {
      "name": "gap_resolved",
      "requirementRefs": ["FR-COL-004", "FR-COL-005"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "gapId", "type": "string", "required": true },
        { "name": "shardId", "type": "string", "required": true },
        { "name": "gapStartSlot", "type": "string<digits>", "required": true },
        { "name": "gapEndSlot", "type": "string<digits>", "required": true },
        { "name": "reason", "type": "string", "required": true },
        {
          "name": "recoveryStatus",
          "type": "string(UNRECOVERED|RECOVERING|RECOVERED|DECLARED_UNRECOVERABLE)",
          "required": true
        },
        { "name": "registeredAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "resolvedAt", "type": "string<utc-timestamp>|null", "required": true }
      ]
    },
    {
      "name": "backfill_completed",
      "requirementRefs": ["FR-COL-005"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "backfillJobId", "type": "string", "required": true },
        { "name": "backfillReason", "type": "string", "required": true },
        { "name": "historicalEventAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "retrievedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "retrospectiveOnly", "type": "boolean", "required": true },
        { "name": "wouldHaveBeenObservableLive", "type": "boolean|null", "required": true },
        { "name": "availabilityProof", "type": "object{method,liveReceiptRef?}", "required": true }
      ]
    },
    {
      "name": "decode_paused",
      "requirementRefs": ["FR-COL-007"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "pauseId", "type": "string", "required": true },
        { "name": "scopeId", "type": "string", "required": true },
        { "name": "programId", "type": "string", "required": true },
        { "name": "programVersion", "type": "string", "required": true },
        { "name": "decoderVersion", "type": "string", "required": true },
        {
          "name": "reason",
          "type": "string(UNKNOWN_INSTRUCTION_VARIANT|ACCOUNT_LAYOUT_CHANGE|DECODER_DRIFT|PARITY_FAILURE|PROGRAM_UPGRADE)",
          "required": true
        },
        { "name": "rawEventsPreserved", "type": "boolean(true)", "required": true },
        { "name": "pausedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "revalidatedAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "incidentId", "type": "string", "required": true }
      ]
    },
    {
      "name": "incident_opened",
      "requirementRefs": ["FR-COL-007", "FR-COL-010"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "incidentId", "type": "string", "required": true },
        { "name": "scopeId", "type": "string|null", "required": true },
        { "name": "partitionId", "type": "string|null", "required": true },
        { "name": "kind", "type": "string", "required": true },
        { "name": "severity", "type": "string(INFO|WARNING|CRITICAL)", "required": true },
        { "name": "openedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "resolvedAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "evidenceRefs", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "health_snapshot",
      "requirementRefs": ["FR-COL-008"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "partitionId", "type": "string", "required": true },
        {
          "name": "connectedState",
          "type": "string(CONNECTED|DISCONNECTED|CONNECTING)",
          "required": true
        },
        { "name": "endpointGeneration", "type": "integer", "required": true },
        { "name": "headSlot", "type": "string<digits>", "required": true },
        { "name": "finalizedSlot", "type": "string<digits>", "required": true },
        { "name": "checkpointLag", "type": "integer", "required": true },
        { "name": "gapCount", "type": "integer", "required": true },
        { "name": "gapDurationSeconds", "type": "number", "required": true },
        {
          "name": "backfillStatus",
          "type": "string(IDLE|QUEUED|RUNNING|PARTIAL|BLOCKED)",
          "required": true
        },
        { "name": "decodeFailureRate", "type": "number[0,1]", "required": true },
        { "name": "streamedBytes", "type": "number", "required": true },
        { "name": "eventRate", "type": "number", "required": true },
        { "name": "deduplicationRate", "type": "number[0,1]", "required": true },
        { "name": "resourceConsumption", "type": "object{cpuPercent,memoryMb}", "required": true },
        { "name": "sampledAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "capacity_paused",
      "requirementRefs": ["FR-COL-010"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "ceilingSetId", "type": "string", "required": true },
        { "name": "cpuCoreLimit", "type": "number", "required": true },
        { "name": "memoryMbLimit", "type": "number", "required": true },
        { "name": "networkBandwidthMbps", "type": "number", "required": true },
        { "name": "activeSubscriptionLimit", "type": "number", "required": true },
        { "name": "eventRatePerSecLimit", "type": "number", "required": true },
        { "name": "rawStorageDailyMbLimit", "type": "number", "required": true },
        { "name": "retryMaxPerHour", "type": "number", "required": true },
        { "name": "monthlyCreditQuota", "type": "number", "required": true },
        { "name": "sustainableContractId", "type": "string", "required": true }
      ]
    },
    {
      "name": "reconnected",
      "requirementRefs": ["FR-COL-009"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "shardId", "type": "string", "required": true },
        { "name": "fencingToken", "type": "string<digits>", "required": true },
        { "name": "cursorPosition", "type": "string<digits>", "required": true },
        { "name": "updatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "first_seen_recorded",
      "requirementRefs": ["FR-COL-011", "FR-COL-012"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "eventToCollectorMs", "type": "number", "required": true },
        { "name": "collectorToFeatureMs", "type": "number", "required": true },
        { "name": "featureToDecisionMs", "type": "number", "required": true },
        { "name": "decisionToDeliveryMs", "type": "number", "required": true },
        { "name": "providerComparisonMs", "type": "number", "required": true },
        { "name": "isFirstPartyVerifiedScope", "type": "boolean", "required": true }
      ]
    }
  ]
}
