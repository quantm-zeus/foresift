{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "data",
  "description": "Data-truth telemetry events for canonical identity, immutable observations/revisions, point-in-time replay, backfill receipts, field-quality flags, acquisition decisions, and source-dependence lineage. Every event carries the instant fields and evidence references its requirement demands; no event ever reports a fabricated success state.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — this file defines the event contracts the requirement manifest maps to (telemetry/data.*); emitter wiring lands with the observability milestone (dependency group G2), so nothing publishes these event names yet. Field lists mirror the authoritative schemas/repos exactly.",
  "requirementsCovered": ["FR-DATA-002", "FR-DATA-003", "FR-DATA-005", "FR-DATA-006", "FR-DATA-007", "FR-DATA-009", "FR-DATA-013", "FR-DATA-016"],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "observation.committed",
      "description": "An observation row was durably committed with its unique receipt hash (append-only; never rewritten).",
      "requirementRefs": ["FR-DATA-002"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "observationId", "type": "string", "required": true },
        {
          "name": "subjectPoolId",
          "type": "string|null",
          "required": true,
          "notes": "Null for asset-scoped observations."
        },
        {
          "name": "subjectAssetId",
          "type": "string|null",
          "required": true,
          "notes": "Null for pool-scoped observations."
        },
        { "name": "eventAt", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "availableAt",
          "type": "string<utc-timestamp>",
          "required": true,
          "notes": "Replay boundary input (FR-DATA-003)."
        },
        { "name": "availabilityProvenance", "type": "string(§13.2 vocabulary)", "required": true },
        { "name": "rawAmount", "type": "string|null", "required": true },
        { "name": "decimals", "type": "integer|null", "required": true },
        {
          "name": "receiptHash",
          "type": "string",
          "required": true,
          "notes": "Unique content receipt; audit chain anchor."
        }
      ]
    },
    {
      "name": "revision.created",
      "description": "A superseding revision was recorded against an existing immutable anchor observation. Revisions carry no receipt of their own — the anchor retains its original receipt immutably, and the revision cites it via supersededReceiptHash.",
      "requirementRefs": ["FR-DATA-002"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "observationId", "type": "string", "required": true },
        { "name": "revisionNo", "type": "integer", "required": true },
        {
          "name": "supersededReceiptHash",
          "type": "string",
          "required": true,
          "notes": "Receipt hash of the immutable anchor being corrected."
        },
        {
          "name": "availableAt",
          "type": "string<utc-timestamp>",
          "required": true,
          "notes": "The revision is visible to replay only at or after this instant."
        }
      ]
    },
    {
      "name": "replay.served",
      "description": "A point-in-time replay read resolved observations at an explicit decision time T via the shared visibleAt predicate.",
      "requirementRefs": ["FR-DATA-003"],
      "tier": "REPLAYABLE_RAW_PAYLOADS",
      "fields": [
        {
          "name": "asOfInstant",
          "type": "string<utc-timestamp>",
          "required": true,
          "notes": "Explicit T — replay never serves an implicit current state."
        },
        { "name": "resolvedCount", "type": "integer", "required": true },
        { "name": "resolvedViaRevisionCount", "type": "integer", "required": true },
        { "name": "subjectFilter", "type": "string|null", "required": true },
        { "name": "servedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "backfill.completed",
      "description": "A historical backfill receipt was recorded under the §13.6 no-backdating guard (available_at may not precede retrieval without a live-receipt proof).",
      "requirementRefs": ["FR-DATA-002", "FR-DATA-003"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "backfillReceiptId", "type": "string", "required": true },
        { "name": "backfillJobId", "type": "string", "required": true },
        { "name": "backfillReason", "type": "string", "required": true },
        { "name": "historicalEventAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "retrievedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "retrospectiveOnly", "type": "boolean", "required": true },
        { "name": "wouldHaveBeenObservableLive", "type": "boolean|null", "required": true },
        {
          "name": "availabilityProofMethod",
          "type": "string(LIVE_RECEIPT_REFERENCE|RECOVERY_FETCH_COMMIT|MANUAL_IMPORT_RECEIPT)",
          "required": true
        },
        { "name": "liveReceiptRef", "type": "string|null", "required": true }
      ]
    },
    {
      "name": "quality.flagged",
      "description": "Field-level quality was recorded per §13.9 vocabulary; null values always carry explanatory codes (null alone is insufficient).",
      "requirementRefs": ["FR-DATA-005", "FR-DATA-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "fieldQualityId", "type": "string", "required": true },
        { "name": "observationId", "type": "string", "required": true },
        { "name": "fieldPath", "type": "string", "required": true },
        { "name": "valueRaw", "type": "string|null", "required": true },
        { "name": "qualityCodes", "type": "array<string>(§13.9 codes)", "required": true },
        { "name": "state", "type": "string(USABLE|CODED_NULL|CODED_VALUE)", "required": true },
        { "name": "recordedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "acquisition.recorded",
      "description": "An evidence-acquisition decision was recorded in the §13.8 state vocabulary; failure states persist explicitly and are never rewritten into success.",
      "requirementRefs": ["FR-DATA-002", "FR-DATA-006"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "decisionId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "evidenceFamily", "type": "string", "required": true },
        { "name": "policyVersion", "type": "string", "required": true },
        { "name": "state", "type": "string(§13.8 AcquisitionState vocabulary)", "required": true },
        {
          "name": "requestedAt",
          "type": "string<utc-timestamp>|null",
          "required": true,
          "notes": "Null when policy did not request the acquisition (NOT_REQUESTED_BY_POLICY carries no lifecycle timestamps)."
        },
        {
          "name": "completedAt",
          "type": "string<utc-timestamp>|null",
          "required": true,
          "notes": "Null for every not-completed state (e.g. PROVIDER_UNAVAILABLE)."
        }
      ]
    },
    {
      "name": "dependence.edge.updated",
      "description": "A source-dependence edge was recorded with its independence evidence and label; edges feed independence-group computation for FR-DATA-006.",
      "requirementRefs": ["FR-DATA-006"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "edgeId", "type": "string", "required": true },
        {
          "name": "sourceA",
          "type": "string",
          "required": true,
          "notes": "Canonical order enforced: sourceA < sourceB."
        },
        { "name": "sourceB", "type": "string", "required": true },
        { "name": "sharedUpstreamLineageKeys", "type": "array<string>", "required": true },
        { "name": "valueErrorTimingCorrelation", "type": "number[-1,1]", "required": true },
        { "name": "outageOverlap", "type": "number[0,1]", "required": true },
        { "name": "firstSeenLagAgreement", "type": "number[0,1]", "required": true },
        { "name": "fingerprintSimilarity", "type": "number[0,1]", "required": true },
        {
          "name": "label",
          "type": "string(AVAILABLE_AT_THE_TIME|DIAGNOSTIC_RETROSPECTIVE)",
          "required": true
        },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "backfill.provenance_recorded",
      "description": "A retrospectively fetched observation recorded its immutable original coordinates and actual retrieval/availability boundary; historical event time is never used as availability time.",
      "requirementRefs": ["FR-DATA-007"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "observationId", "type": "string", "required": true },
        { "name": "subjectPoolId", "type": "string|undefined", "required": false },
        { "name": "subjectAssetId", "type": "string|undefined", "required": false },
        { "name": "retrievedAsBackfill", "type": "literal<true>", "required": true },
        { "name": "originalCoordinates", "type": "object<OriginalEventCoordinatesSchema>", "required": true },
        { "name": "eventAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "fetchedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "unavailabilityReason", "type": "string", "required": true }
      ]
    },
    {
      "name": "decision.timeline_recorded",
      "description": "A candidate decision timeline recorded the complete delivery lifecycle, including the exclusive versioned counterfactual arm for a non-delivery.",
      "requirementRefs": ["FR-DATA-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "decisionId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "policyVersion", "type": "string|undefined", "required": false },
        { "name": "decisionReadyAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "policyDecidedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "workflowCompletedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "deliveryEligibleAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "deliveredAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "counterfactualDeliveryAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "counterfactualVersion", "type": "integer|string|null", "required": true },
        { "name": "validUntil", "type": "string<utc-timestamp>|undefined", "required": false },
        { "name": "expiredAt", "type": "string<utc-timestamp>|null|undefined", "required": false }
      ]
    },
    {
      "name": "dependence.edge_validity_updated",
      "description": "A declared or empirical source-dependence edge recorded its validity interval, evidence, confidence, and effective independent-evidence multiplier.",
      "requirementRefs": ["FR-DATA-013"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "sourceIdA", "type": "string", "required": true },
        { "name": "sourceIdB", "type": "string", "required": true },
        { "name": "method", "type": "string(DECLARED|EMPIRICAL)", "required": true },
        { "name": "validFrom", "type": "string<utc-timestamp>", "required": true },
        { "name": "validUntil", "type": "string<utc-timestamp>|null|undefined", "required": false },
        { "name": "evidenceIds", "type": "array<string>", "required": true },
        { "name": "confidence", "type": "number[0,1]", "required": true },
        { "name": "effectiveIndependenceMultiplier", "type": "number[0,1]", "required": true }
      ]
    },
    {
      "name": "conflict.classified",
      "description": "A provider conflict classified all contributing raw observations as benign variance, common-upstream duplication, material disagreement, or unresolved decision-critical conflict.",
      "requirementRefs": ["FR-DATA-016"],
      "tier": "CRITICAL_OBSERVATIONS_CHECKPOINTS",
      "fields": [
        { "name": "conflictId", "type": "string", "required": true },
        { "name": "conflictClass", "type": "string(BENIGN_LATENCY_ROUNDING_VARIANCE|COMMON_UPSTREAM_DUPLICATION|MATERIAL_DISAGREEMENT|UNRESOLVED_DECISION_CRITICAL)", "required": true },
        { "name": "observationIds", "type": "array<string>", "required": true },
        { "name": "fieldPath", "type": "string|undefined", "required": false },
        { "name": "resolvedByRule", "type": "string|null|undefined", "required": false },
        { "name": "detectedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>|undefined", "required": false },
        { "name": "details", "type": "record<string,unknown>", "required": true }
      ]
    }
  ]
}
