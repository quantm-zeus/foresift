{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "disc",
  "description": "Declarative discovery, finite batch-monitoring, promotion, and coverage contracts projected from the authoritative shared schemas. Catalog metadata contains no provider payloads, credentials, tokens, or secret material.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring is deferred to G2 observability.",
  "requirementsCovered": [
    "FR-DISC-001",
    "FR-DISC-002",
    "FR-DISC-003",
    "FR-DISC-004",
    "FR-DISC-005"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "entry_recorded",
      "requirementRefs": ["FR-DISC-001", "FR-DISC-002", "FR-DISC-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "assetRepresentationId", "type": "string", "required": true },
        { "name": "sourceId", "type": "string", "required": true },
        { "name": "sourceClass", "type": "string(§63.2 vocabulary)", "required": true },
        { "name": "sourceObservedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourcePublishedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourceAvailableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "firstFetchedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstReceivedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstIngestedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "chainCoordinates", "type": "string", "required": false },
        { "name": "sourceRank", "type": "integer", "required": false },
        { "name": "sourceMetadataHash", "type": "string<sha256>", "required": true },
        { "name": "discoveryPolicyVersion", "type": "string", "required": true },
        { "name": "collectorCoverageManifestId", "type": "string", "required": false },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "attribution_appended",
      "requirementRefs": ["FR-DISC-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "assetRepresentationId", "type": "string", "required": true },
        { "name": "sourceId", "type": "string", "required": true },
        { "name": "sourceClass", "type": "string(§63.2 vocabulary)", "required": true },
        { "name": "sourceObservedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourcePublishedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourceAvailableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "firstFetchedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstReceivedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstIngestedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "chainCoordinates", "type": "string", "required": false },
        { "name": "sourceRank", "type": "integer", "required": false },
        { "name": "sourceMetadataHash", "type": "string<sha256>", "required": true },
        { "name": "discoveryPolicyVersion", "type": "string", "required": true },
        { "name": "collectorCoverageManifestId", "type": "string", "required": false },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "batch_executed",
      "requirementRefs": ["FR-DISC-004"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "batchId", "type": "string", "required": true },
        { "name": "batchSize", "type": "integer", "required": true },
        { "name": "candidateIds", "type": "array<string>", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "scheduledAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "monitor_decision",
      "requirementRefs": ["FR-DISC-004", "FR-DISC-005"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        {
          "name": "decision",
          "type": "string(REJECT_CHEAP|MONITOR_CHEAP|PROMOTE_TO_VERIFY)",
          "required": true
        }
      ]
    },
    {
      "name": "promoted",
      "requirementRefs": ["FR-DISC-005"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "decisionId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "policyVersion", "type": "string", "required": true },
        { "name": "featureSnapshotVersion", "type": "string", "required": true },
        { "name": "inputsHash", "type": "string<sha256>", "required": true },
        { "name": "decisionVersion", "type": "string", "required": true },
        {
          "name": "decision",
          "type": "string(REJECT_CHEAP|MONITOR_CHEAP|PROMOTE_TO_VERIFY)",
          "required": true
        },
        { "name": "rationale", "type": "string", "required": true },
        { "name": "decidedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "monitor_expired",
      "requirementRefs": ["FR-DISC-004"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "assetRepresentationId", "type": "string", "required": true },
        {
          "name": "state",
          "type": "string(NEW|MONITORING_CHEAP|PROMOTED_TO_VERIFY|REJECTED_CHEAP|EXPIRED_CHEAP)",
          "required": true
        },
        { "name": "checkCount", "type": "integer", "required": true },
        { "name": "maxChecks", "type": "integer", "required": true },
        { "name": "backoffSeconds", "type": "number", "required": true },
        { "name": "lastCheckedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "nextCheckDueAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "expiresAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "stalenessLimitSeconds", "type": "number", "required": true },
        { "name": "decisionHistory", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "coverage_measured",
      "requirementRefs": ["FR-DISC-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "manifestId", "type": "string", "required": true },
        { "name": "populationClass", "type": "string(§63.7 vocabulary)", "required": true },
        { "name": "collectorScopeIds", "type": "array<string>", "required": true },
        { "name": "sourceIds", "type": "array<string>", "required": true },
        { "name": "startSlot", "type": "string<digits>", "required": true },
        { "name": "endSlot", "type": "string<digits>", "required": true },
        { "name": "startTime", "type": "string<utc-timestamp>", "required": true },
        { "name": "endTime", "type": "string<utc-timestamp>", "required": true },
        { "name": "knownGapsCount", "type": "integer", "required": true },
        { "name": "rightsExclusions", "type": "array<string>", "required": true },
        { "name": "selectionProbabilities", "type": "object<number[0,1]>", "required": false },
        { "name": "sourceDependenceDisclosed", "type": "boolean", "required": true }
      ]
    }
  ]
}
