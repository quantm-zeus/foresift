{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "disc",
  "description": "Declarative discovery, finite batch-monitoring, promotion, and coverage contracts projected from the authoritative shared schemas. Catalog metadata contains no provider payloads, credentials, tokens, or secret material.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring is deferred to G2 observability.",
  "requirementsCovered": [
    "FR-DISC-001",
    "FR-DISC-002",
    "FR-DISC-003",
    "FR-DISC-004",
    "FR-DISC-005",
    "FR-DISC-006",
    "FR-DISC-007",
    "FR-DISC-008",
    "FR-DISC-009",
    "FR-DISC-010",
    "FR-DISC-011",
    "FR-DISC-012",
    "FR-DISC-013",
    "FR-DISC-014"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "entry_recorded",
      "requirementRefs": ["FR-DISC-001", "FR-DISC-002", "FR-DISC-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "assetRepresentationId", "type": "string", "required": true },
        { "name": "sourceId", "type": "string", "required": true },
        { "name": "sourceClass", "type": "string(§63.2 vocabulary)", "required": true },
        { "name": "sourceObservedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourcePublishedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourceAvailableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "firstFetchedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstReceivedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstIngestedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "chainCoordinates", "type": "string", "required": false },
        { "name": "sourceRank", "type": "integer", "required": false },
        { "name": "sourceMetadataHash", "type": "string<sha256>", "required": true },
        { "name": "discoveryPolicyVersion", "type": "string", "required": true },
        { "name": "collectorCoverageManifestId", "type": "string", "required": false },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "attribution_appended",
      "requirementRefs": ["FR-DISC-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "assetRepresentationId", "type": "string", "required": true },
        { "name": "sourceId", "type": "string", "required": true },
        { "name": "sourceClass", "type": "string(§63.2 vocabulary)", "required": true },
        { "name": "sourceObservedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourcePublishedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "sourceAvailableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "firstFetchedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstReceivedAt", "type": "string<utc-timestamp>", "required": false },
        { "name": "firstIngestedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "chainCoordinates", "type": "string", "required": false },
        { "name": "sourceRank", "type": "integer", "required": false },
        { "name": "sourceMetadataHash", "type": "string<sha256>", "required": true },
        { "name": "discoveryPolicyVersion", "type": "string", "required": true },
        { "name": "collectorCoverageManifestId", "type": "string", "required": false },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
