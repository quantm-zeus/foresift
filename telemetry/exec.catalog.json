{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "exec",
  "description": "Read-only execution simulation telemetry contracts: scenario resolution, simulation recording, net-return composition, outcome classification, tradability decision, observation plans, frozen replay manifests, adapter resolution/parity/degradation, concurrent shadow aggregation, point-in-time route selection, and quote-evidence recording.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — this file defines the event contracts the requirement manifest maps to (telemetry/exec.*); emitter wiring lands with the observability milestone (dependency group G2), so nothing publishes these event names yet. Field lists mirror the authoritative schemas in packages/shared-schemas/src/exec.ts exactly.",
  "requirementsCovered": [
    "FR-EXEC-001",
    "FR-EXEC-002",
    "FR-EXEC-003",
    "FR-EXEC-005",
    "FR-EXEC-006",
    "FR-EXEC-007",
    "FR-EXEC-008",
    "FR-EXEC-009",
    "FR-EXEC-010",
    "FR-EXEC-011",
    "FR-EXEC-013",
    "FR-EXEC-015",
    "FR-EXEC-016",
    "FR-EXEC-017",
    "FR-EXEC-018",
    "FR-EXEC-019",
    "FR-EXEC-020",
    "FR-EXEC-021",
    "FR-EXEC-022"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "exec.scenario_resolved",
      "description": "A pre-registered, versioned execution scenario was resolved against the registry and hash-pinned for evaluation; registration mismatches and unregistered scenarios are refused (§64.2).",
      "authoritativeSchema": "ExecutionScenarioSchema",
      "requirementRefs": ["FR-EXEC-001", "FR-EXEC-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "scenarioId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "notionalUsd", "type": "string<decimal>", "required": true },
        { "name": "deterministicActionDelaySeconds", "type": "integer>=0", "required": true },
        { "name": "entryPolicyVersionId", "type": "string", "required": true },
        { "name": "exitPolicyVersionId", "type": "string", "required": true },
        { "name": "maximumEntryImpact", "type": "number>=0", "required": true },
        { "name": "maximumExitImpact", "type": "number>=0", "required": true },
        { "name": "allowPartialFill", "type": "boolean", "required": true },
        { "name": "minimumFillFraction", "type": "number[0,1]", "required": true },
        { "name": "maximumFillDurationSeconds", "type": "integer>=0", "required": true },
        { "name": "feePolicyVersionId", "type": "string", "required": true },
        { "name": "conservativeStressPolicyId", "type": "string", "required": true },
        { "name": "requiredPoolAdapterCoverage", "type": "string(COMPLETE|BOUNDED_APPROXIMATION)", "required": true },
        { "name": "registeredHash", "type": "string<sha256-ref>", "required": true }
      ]
    },
    {
      "name": "exec.simulation_recorded",
      "description": "One read-only execution simulation result was recorded with entry/exit fills, tradability verdict, outcome labels, and the §64.4 state-snapshot reference (§64.12, FR-EXEC-002).",
      "authoritativeSchema": "ExecutionSimulationSchema",
      "requirementRefs": ["FR-EXEC-002", "FR-EXEC-003", "FR-EXEC-006", "FR-EXEC-007"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "simulationId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "scenarioId", "type": "string", "required": true },
        { "name": "scenarioVersion", "type": "string", "required": true },
        { "name": "outcomeProfileVersion", "type": "string", "required": true },
        { "name": "entry", "type": "EntryFillResult", "required": true },
        { "name": "exit", "type": "ExitFillResult|null", "required": true },
        { "name": "tradabilityVerdict", "type": "string(TRADABLE|UNCERTAINTY_BLOCKED|TARGET_NOT_EXECUTABLE|STATE_INCOMPLETE|EXECUTION_UNAVAILABLE|POOL_MATH_UNSUPPORTED|INSUFFICIENT_DATA)", "required": true },
        { "name": "tradableFailureReason", "type": "string(SECURITY_OR_LIQUIDITY|EXPLICIT_FAILURE_CLAUSE)|null", "required": true },
        { "name": "signalLabel", "type": "string(SIGNAL_SUCCESS|SIGNAL_FAILURE)|null", "required": true },
        { "name": "tradableLabel", "type": "string<outcome-class>|null", "required": true },
        { "name": "outcomeMaturity", "type": "string(PENDING|PARTIALLY_MATURED|FULLY_MATURED|CENSORED|INVALID_DATA)", "required": true },
        { "name": "stateSnapshotId", "type": "string", "required": true },
        { "name": "replayManifestId", "type": "string", "required": true },
        { "name": "pathAmbiguity", "type": "{primaryOrdering, ambiguous}", "required": true },
        { "name": "observedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "availableAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "qualityCodes", "type": "array<string>", "required": true },
        { "name": "schemaRegistryVersion", "type": "integer(1)", "required": true }
      ]
    },
    {
      "name": "exec.net_return_composed",
      "description": "A §64.9 net-return breakdown was composed with every cost leg explicit — omitted legs are refused, never assumed zero (FR-EXEC-003, FR-EXEC-018).",
      "authoritativeSchema": "NetReturnBreakdownSchema",
      "requirementRefs": ["FR-EXEC-003", "FR-EXEC-018"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "grossReturnUsd", "type": "string<decimal-signed>", "required": true },
        { "name": "poolFeesUsd", "type": "string<decimal>", "required": true },
        { "name": "aggregatorFeesUsd", "type": "string<decimal>", "required": true },
        { "name": "tokenTransferFeesUsd", "type": "string<decimal>", "required": true },
        { "name": "priorityNetworkFeesUsd", "type": "string<decimal>", "required": true },
        { "name": "executionImpactUsd", "type": "string<decimal>", "required": true },
        { "name": "failedAttemptsUsd", "type": "string<decimal>", "required": true },
        { "name": "partialFillPenaltyUsd", "type": "string<decimal>", "required": true },
        { "name": "residualInventoryUsd", "type": "string<decimal>", "required": true },
        { "name": "adverseSelectionMevBufferUsd", "type": "string<decimal>", "required": true },
        { "name": "quoteConversionDepegUsd", "type": "string<decimal>", "required": true },
        { "name": "accountCreationRentUsd", "type": "string<decimal>", "required": true },
        { "name": "netReturnUsd", "type": "string<decimal-signed>", "required": true },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "exec.outcome_classified",
      "description": "An outcome was classified under the single §8.2 precedence law with explicit censor/invalid reasons, signal labels on a separate axis, and FR-EXEC-006 profit-render refusal (FR-EXEC-006, INV-011/012).",
      "authoritativeSchema": "ExecutionSimulationSchema",
      "requirementRefs": ["FR-EXEC-006", "FR-EXEC-007"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "simulationId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "tradableLabel", "type": "string<outcome-class>", "required": true },
        { "name": "signalLabel", "type": "string(SIGNAL_SUCCESS|SIGNAL_FAILURE)|null", "required": true },
        { "name": "outcomeMaturity", "type": "string(PENDING|PARTIALLY_MATURED|FULLY_MATURED|CENSORED|INVALID_DATA)", "required": true },
        { "name": "tradableFailureReason", "type": "string(SECURITY_OR_LIQUIDITY|EXPLICIT_FAILURE_CLAUSE)|null", "required": true },
        { "name": "censorReason", "type": "string|null", "required": true },
        { "name": "invalidReason", "type": "string|null", "required": true },
        { "name": "untradableSignalWin", "type": "boolean", "required": true },
        { "name": "profitRenderRefused", "type": "boolean", "required": true },
        { "name": "denominatorClassified", "type": "integer>=0", "required": true },
        { "name": "denominatorCensored", "type": "integer>=0", "required": true },
        { "name": "denominatorInvalid", "type": "integer>=0", "required": true },
        { "name": "denominatorPending", "type": "integer>=0", "required": true },
        { "name": "denominatorTerminal", "type": "integer>=0", "required": true },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    },
    {
      "name": "exec.tradability_decided",
      "description": "The FR-EXEC-007/FR-EXEC-012/FR-EXEC-017 tradability gate decided a candidate: every required stress kind recorded, the profile pass matrix enforced, the conservative pass required by default, and diagnostic signal labels preserved verbatim on block (AC-235).",
      "authoritativeSchema": "ScenarioPassMatrixSchema",
      "requirementRefs": ["FR-EXEC-007", "FR-EXEC-012", "FR-EXEC-017", "FR-EXEC-020"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "matrixId", "type": "string", "required": true },
        { "name": "outcomeProfileVersion", "type": "string", "required": true },
        { "name": "requiredKinds", "type": "array<string<stress-scenario-kind>>", "required": true },
        { "name": "results", "type": "array<StressScenarioResult>", "required": true },
        { "name": "conservativeStressPolicyId", "type": "string", "required": true },
        { "name": "tradabilityVerdict", "type": "string<tradability-verdict>", "required": true },
        { "name": "blockReason", "type": "string<tradability-verdict>|null", "required": true },
        { "name": "preservedSignalLabel", "type": "string<outcome-class>|null", "required": true },
        { "name": "confirmedOpportunity", "type": "boolean", "required": true },
        { "name": "uncertaintyBound", "type": "{stateCompleteness, relativeUncertainty, policyLimit, qualityCodes}|null", "required": true },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "exec.observation_plan_issued",
      "description": "A finite §64.14/FR-EXEC-011 selective outcome-observation plan was issued with cadence, fields, sources, bounded duration, quota ceiling, degradation policy, and resolution floor; sampled plans carry inclusion probability with stratum and population limits (FR-EXEC-011, FR-MAT-007).",
      "authoritativeSchema": "OutcomeObservationPlanSchema",
      "requirementRefs": ["FR-EXEC-011"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "planId", "type": "string", "required": true },
        { "name": "planVersion", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "triggerClass", "type": "string(DEEP_RESEARCH|EARLY_WATCH|CONFIRMED_OPPORTUNITY|CONTROL_SAMPLE|SHADOW_PORTFOLIO)", "required": true },
        { "name": "cadenceSeconds", "type": "integer>=1", "required": true },
        { "name": "observedFields", "type": "array<string>", "required": true },
        { "name": "providerSourceIds", "type": "array<string>", "required": true },
        { "name": "durationSeconds", "type": "integer>=1", "required": true },
        { "name": "quotaCeiling", "type": "object", "required": true },
        { "name": "degradationPolicyId", "type": "string", "required": true },
        { "name": "resolutionFloor", "type": "{temporalSeconds, poolStateComplete, liquidityDepthMinUsd}", "required": true },
        { "name": "inclusionProbability", "type": "number[0,1]|null", "required": true },
        { "name": "stratum", "type": "string|null", "required": true },
        { "name": "populationLimit", "type": "string|null", "required": true },
        { "name": "registeredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "exec.replay_manifest_frozen",
      "description": "A §31.5/FR-EXEC-010 replay manifest was frozen with the assumption hash over exact scenario payloads, adapter/code/policy versions, and the code-and-dependency hash; frozen replay reproduces stress outcomes (AC-127).",
      "authoritativeSchema": "ReplayManifestSchema",
      "requirementRefs": ["FR-EXEC-010"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "replayId", "type": "string", "required": true },
        { "name": "asOf", "type": "string<utc-timestamp>", "required": true },
        { "name": "datasetVersion", "type": "string", "required": true },
        { "name": "populationClaim", "type": "string", "required": true },
        { "name": "candidateUniverseHash", "type": "string<sha256-ref>", "required": true },
        { "name": "observationCutoff", "type": "string<utc-timestamp>", "required": true },
        { "name": "collectorCoverageManifestId", "type": "string", "required": true },
        { "name": "providerDependenceVersion", "type": "string", "required": true },
        { "name": "featureVersion", "type": "string", "required": true },
        { "name": "rankingVersion", "type": "string", "required": true },
        { "name": "workflowVersion", "type": "string", "required": true },
        { "name": "promptVersion", "type": "string", "required": true },
        { "name": "toolProfileVersion", "type": "string", "required": true },
        { "name": "modelProfileVersion", "type": "string", "required": true },
        { "name": "outcomeProfileVersion", "type": "string", "required": true },
        { "name": "policyVersion", "type": "string", "required": true },
        { "name": "deliveryLatencyPolicyVersion", "type": "string", "required": true },
        { "name": "capacityContractVersion", "type": "string", "required": true },
        { "name": "poolMathAdapterVersions", "type": "array<string>", "required": true },
        { "name": "executionScenarioVersions", "type": "array<string>", "required": true },
        { "name": "artifactIds", "type": "array<string>", "required": true },
        { "name": "holdoutExposureSnapshotId", "type": "string", "required": true },
        { "name": "codeAndDependencyHash", "type": "string<sha256-ref>", "required": true }
      ]
    },
    {
      "name": "exec.adapter_resolved",
      "description": "A pool-math adapter was resolved fail-closed for a chain/program/version/curve/layout binding from the signed program-support manifests; unknown or unsupported bindings refuse (§64.3, FR-EXEC-015).",
      "authoritativeSchema": "AdapterRegistryEntrySchema",
      "requirementRefs": ["FR-EXEC-013", "FR-EXEC-015"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "adapterId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "chainId", "type": "string<caip-2>", "required": true },
        { "name": "programId", "type": "string", "required": true },
        { "name": "supportedProgramVersions", "type": "array<string>", "required": true },
        { "name": "curveTypes", "type": "array<string>", "required": true },
        { "name": "family", "type": "string<adapter-family>", "required": true },
        { "name": "accountLayoutVersion", "type": "string", "required": true },
        { "name": "supportState", "type": "string(AVAILABLE|DEGRADED|UNAVAILABLE)", "required": true },
        { "name": "parityGateVersion", "type": "string|null", "required": true },
        { "name": "fixtureBundleHash", "type": "string<sha256-ref>|null", "required": true }
      ]
    },
    {
      "name": "exec.adapter_parity_evaluated",
      "description": "The §64.11/FR-EXEC-016 parity gate evaluated an adapter over deterministic vectors and observed-trade tolerance bands; failure transitions the adapter to DEGRADED/UNAVAILABLE and opens an incident (FR-EXEC-016).",
      "authoritativeSchema": "AdapterRegistryEntrySchema",
      "requirementRefs": ["FR-EXEC-016", "FR-EXEC-021"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "gateId", "type": "string", "required": true },
        { "name": "adapterId", "type": "string", "required": true },
        { "name": "adapterVersion", "type": "string", "required": true },
        { "name": "gateVersion", "type": "string", "required": true },
        { "name": "deterministicVectorsPassed", "type": "integer>=0", "required": true },
        { "name": "deterministicVectorsFailed", "type": "array<string>", "required": true },
        { "name": "observedTradesEvaluated", "type": "integer>=0", "required": true },
        { "name": "observedTradeFailures", "type": "array<string>", "required": true },
        { "name": "toleranceBps", "type": "integer>=0", "required": true },
        { "name": "passed", "type": "boolean", "required": true },
        { "name": "incidentCause", "type": "string(PARITY_DRIFT|PROGRAM_UPGRADE)|null", "required": true },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "exec.adapter_degraded",
      "description": "FR-EXEC-021 tradability degradation fired on adapter deprecation, program upgrade, parity drift, or unknown extension — scope-isolated, history preserved, re-evaluation queued, and no new confirmed alerts until signed revalidation (AC-237).",
      "authoritativeSchema": "AdapterRegistryEntrySchema",
      "requirementRefs": ["FR-EXEC-021"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "degradationId", "type": "string", "required": true },
        { "name": "cause", "type": "string(ADAPTER_DEPRECATED|PROGRAM_UPGRADE|PARITY_DRIFT|UNKNOWN_EXTENSION)", "required": true },
        { "name": "chainId", "type": "string<caip-2>", "required": true },
        { "name": "programId", "type": "string", "required": true },
        { "name": "programVersion", "type": "string", "required": true },
        { "name": "curveType", "type": "string", "required": true },
        { "name": "accountLayoutVersion", "type": "string", "required": true },
        { "name": "adapterId", "type": "string", "required": true },
        { "name": "adapterVersion", "type": "string", "required": true },
        { "name": "supportState", "type": "string(DEGRADED|UNAVAILABLE)", "required": true },
        { "name": "detectedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "evidenceRef", "type": "string", "required": true },
        { "name": "revalidatedAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "revalidationRef", "type": "string|null", "required": true }
      ]
    },
    {
      "name": "exec.shadow_positions_aggregated",
      "description": "FR-EXEC-019 concurrent shadow positions sharing a pool/route/quote asset/liquidity source/deployer cluster/exit window were aggregated with deterministic lexicographic fill competition — isolated fills cannot each consume the same depth (AC-236).",
      "authoritativeSchema": "ConcurrentShadowAggregateSchema",
      "requirementRefs": ["FR-EXEC-019"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "aggregateId", "type": "string", "required": true },
        { "name": "poolId", "type": "string", "required": true },
        { "name": "routeId", "type": "string|null", "required": true },
        { "name": "sharedLiquidityIdentifiers", "type": "array<string>", "required": true },
        { "name": "concurrentExitCount", "type": "integer>=1", "required": true },
        { "name": "preExitDepthUsd", "type": "string<decimal>", "required": true },
        { "name": "aggregatedRequestedExitsUsd", "type": "string<decimal>", "required": true },
        { "name": "aggregatedFillFraction", "type": "number[0,1]", "required": true },
        { "name": "rejectedExitCount", "type": "integer>=0", "required": true }
      ]
    },
    {
      "name": "exec.route_selected",
      "description": "FR-EXEC-022 point-in-time route selection chose a route eligible at T_user_action — pools/routes created after the action slot are refused retrospectively and migration edges are routable only when completed at or before the action slot (AC-234).",
      "authoritativeSchema": "ExecutionStateSnapshotSchema",
      "requirementRefs": ["FR-EXEC-022", "FR-EXEC-014"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "actionSlot", "type": "string<digits>", "required": true },
        { "name": "routeId", "type": "string|null", "required": true },
        { "name": "refusals", "type": "array<{routeId, reason}>", "required": true },
        { "name": "eligibleOrder", "type": "array<string>", "required": true },
        { "name": "migrationEdgesConsidered", "type": "array<string>", "required": true },
        { "name": "selectedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "exec.quote_evidence_recorded",
      "description": "Quote evidence was recorded as evidence, never execution truth: transactionPayloadRef is structurally null (§64.5/INV-001), route legs are explicit, and quality codes carry the evidence status (FR-EXEC-020).",
      "authoritativeSchema": "QuoteEvidenceSchema",
      "requirementRefs": ["FR-EXEC-005", "FR-EXEC-020"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "quoteId", "type": "string", "required": true },
        { "name": "sourceId", "type": "string", "required": true },
        { "name": "sourceKind", "type": "string(OFFICIAL_PROGRAM_READ|INDEPENDENT_AGGREGATOR|OBSERVED_TRADE)", "required": true },
        { "name": "inTokenMint", "type": "string", "required": true },
        { "name": "outTokenMint", "type": "string", "required": true },
        { "name": "inAmount", "type": "string<decimal>", "required": true },
        { "name": "outAmount", "type": "string<decimal>", "required": true },
        { "name": "quoteAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "observedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "routeLegs", "type": "array<object>", "required": true },
        { "name": "transactionPayloadRef", "type": "null", "required": true },
        { "name": "qualityCodes", "type": "array<string>", "required": true }
      ]
    }
  ]
}
