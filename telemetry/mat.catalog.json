      "fields": [
        { "name": "promotionEvidenceId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "outcomeProfileId", "type": "string", "required": true },
        { "name": "outcomeProfileVersion", "type": "string", "required": true },
        { "name": "scenarioId", "type": "string", "required": true },
        { "name": "scenarioVersion", "type": "string", "required": true },
        { "name": "outcomeLabel", "type": "string", "required": true },
        { "name": "outcomeMaturity", "type": "string", "required": true },
        { "name": "evidenceResolution", "type": "string", "required": true },
        { "name": "requiredNotional", "type": "decimal", "required": true },
        { "name": "requiredDelayPolicyId", "type": "string", "required": true },
        { "name": "requiredAdapterVersion", "type": "string", "required": true },
        { "name": "requiredRouteId", "type": "string", "required": true },
        { "name": "requiredExitPolicyId", "type": "string", "required": true },
        { "name": "exactConfigurationMatch", "type": "boolean", "required": true },
        { "name": "productionPromotionEligible", "type": "boolean", "required": true },
        { "name": "primaryOrdering", "type": "string", "required": true },
        { "name": "pathAmbiguous", "type": "boolean", "required": true },
        { "name": "optimisticSensitivity", "type": "object|null", "required": true },
        { "name": "expirySideEffect", "type": "string|null", "required": true },
