    {
      "name": "mat.subjective_utility_recorded",
      "authoritativeSchema": "SubjectiveUtilityRecordSchema",
      "requirementRefs": ["FR-MAT-006"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "subjectiveUtilityId", "type": "string", "required": true },
        { "name": "subjectId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "labelFamily", "type": "string", "required": true },
        { "name": "utilityLabel", "type": "string", "required": true },
        { "name": "utilityValue", "type": "decimal|null", "required": true },
        { "name": "rationale", "type": "string|null", "required": true },
        { "name": "recordedAt", "type": "utc", "required": true },
        { "name": "createdAt", "type": "utc", "required": true }
      ]
