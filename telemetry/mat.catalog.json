        { "name": "transitionedAt", "type": "utc", "required": true },
        { "name": "recordedAt", "type": "utc", "required": true }
      ]
    },
    {
      "name": "mat.denominator_disclosed",
      "authoritativeSchema": "DenominatorDisclosureSchema",
