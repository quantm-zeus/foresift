{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "mat",
  "description": "Outcome maturity, denominator, sampling, label separation, and promotion evidence contracts.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring is deferred to G2 observability. Field lists mirror packages/shared-schemas/src/mat.ts exactly.",
  "requirementsCovered": [
    "FR-MAT-001",
    "FR-MAT-002",
    "FR-MAT-003",
    "FR-MAT-006",
    "FR-MAT-007",
    "FR-MAT-008",
    "FR-MAT-009",
    "FR-MAT-010",
    "FR-MAT-011",
    "FR-MAT-012"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "mat.maturity_resolved",
      "authoritativeSchema": "OutcomeMaturityStateSchema",
      "requirementRefs": ["FR-MAT-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "maturityStateId", "type": "string", "required": true },
        { "name": "candidateId", "type": "string", "required": true },
        { "name": "outcomeProfileId", "type": "string", "required": true },
        { "name": "outcomeProfileVersion", "type": "string", "required": true },
        { "name": "horizon", "type": "string", "required": true },
        { "name": "scenarioId", "type": "string", "required": true },
        { "name": "scenarioVersion", "type": "string", "required": true },
        { "name": "maturityState", "type": "string", "required": true },
        { "name": "censorReason", "type": "string|null", "required": true },
        { "name": "invalidReason", "type": "string|null", "required": true },
        { "name": "maturedAt", "type": "utc|null", "required": true },
        { "name": "observedAt", "type": "utc", "required": true },
        { "name": "availableAt", "type": "utc", "required": true },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "createdAt", "type": "utc", "required": true }
      ]
    },
    {
      "name": "mat.transition_recorded",
      "authoritativeSchema": "MaturityTransitionSchema",
      "requirementRefs": ["FR-MAT-001", "FR-MAT-002"],
      "tier": "CRITICAL_METADATA",
