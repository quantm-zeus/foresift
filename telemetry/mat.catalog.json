        { "name": "gainObservedAt", "type": "utc|null", "required": true },
        { "name": "postExpiryGainExcluded", "type": "boolean", "required": true },
        { "name": "capacityLimited", "type": "boolean", "required": true },
        { "name": "maximumExecutableNotional", "type": "decimal|null", "required": true },
        { "name": "totalDeployablePortfolioCapacity", "type": "decimal|null", "required": true },
        { "name": "largerCapitalSimulationRef", "type": "string|null", "required": true },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "recordedAt", "type": "utc", "required": true },
        { "name": "createdAt", "type": "utc", "required": true }
