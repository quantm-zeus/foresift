{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "prov",
  "description": "Provider lifecycle telemetry events for operation registration, lifecycle state transitions and refusals, verification TTL expiries and refreshes, deprecation tracking and sunset incidents, migration exceptions, malicious response quarantine, rights changes and use blocking, artifact quarantine/retire actions, activation readiness evaluation, and source fingerprints for empirical dependence analysis. Every event carries structured metadata and audit/evidence references; no event ever carries secret material, private keys, or hazardous payloads.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — this file defines the event contracts the requirement manifest maps to (telemetry/prov.*); emitter wiring lands with the observability milestone (dependency group G2), so nothing publishes these event names yet. Field lists mirror the authoritative schemas in packages/shared-schemas/src/prov.ts exactly.",
  "requirementsCovered": [
    "FR-PROV-001",
    "FR-PROV-002",
    "FR-PROV-003",
    "FR-PROV-008",
    "FR-PROV-009",
    "FR-PROV-010"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "operation.registered",
      "description": "A provider operation definition was registered in the versioned operations catalog, with its capability class, cost class, health status, and verification TTL.",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "capabilityClass",
          "type": "string(READ_MARKET|READ_SECURITY|READ_IDENTITY|READ_TRANSACTION_RAW|READ_TRANSACTION_HISTORY|READ_ACCOUNT_STATE|READ_SOCIAL_AGGREGATE|STREAM_PROGRAM_EVENT|QUOTE_READ_ONLY)",
          "required": true,
          "notes": "Prohibited capability classes (PROHIBITED_TRANSACTION_BUILD, PROHIBITED_SIGN, PROHIBITED_SUBMIT, PROHIBITED_CUSTODY) are refused outright at registration."
        },
        {
          "name": "costClass",
          "type": "string(FREE_UNMETERED|FREE_QUOTA|PAID_EXPLICIT|UNKNOWN_COST|DISABLED)",
          "required": true
        },
        {
          "name": "healthStatus",
          "type": "string(HEALTHY|DEGRADED|SCHEMA_DRIFT|PLAN_UNVERIFIED|RIGHTS_UNVERIFIED|DEPRECATED|SUNSET_PENDING|QUOTA_LOW|QUOTA_EXHAUSTED|AUTH_FAILED|UNSUPPORTED|DISABLED)",
          "required": true
        },
        {
          "name": "initialState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        { "name": "allowedInStrictFree", "type": "boolean", "required": true },
        { "name": "paidFallbackAllowed", "type": "boolean", "required": true },
        { "name": "declaredIndependenceGroup", "type": "string", "required": true },
        { "name": "verificationExpiresAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "registeredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "lifecycle.transitioned",
      "description": "A provider operation transitioned between lifecycle states in the append-only transition ledger (§12.11).",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "fromState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "toState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        { "name": "reasonClass", "type": "string", "required": true },
        { "name": "actor", "type": "string", "required": true },
        {
          "name": "idempotencyKey",
          "type": "string",
          "required": true,
          "notes": "Unique idempotency key preventing duplicate transitions on retry (INV-009)."
        },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "occurredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "lifecycle.refused",
      "description": "An illegal or unauthorized lifecycle state transition was refused by the lifecycle state machine.",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "fromState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "attemptedState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        { "name": "reason", "type": "string", "required": true },
        { "name": "actor", "type": "string", "required": true },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "verification.expired",
      "description": "A provider operation verification expired after exceeding its configured TTL; new active use of decision-critical fields is blocked until reverification (FR-PROV-002).",
      "requirementRefs": ["FR-PROV-002", "FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "kind",
          "type": "string(DOCUMENTATION|PRICING_PLAN|QUOTA|RIGHTS|SCHEMA|ENDPOINT|AUTHENTICATION|DEPRECATION|LIVE_PROBE)",
          "required": true
        },
        { "name": "expiredAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "ttlSeconds", "type": "integer", "required": true },
        {
          "name": "resultingHealthStatus",
          "type": "string(PLAN_UNVERIFIED|RIGHTS_UNVERIFIED|DEGRADED|DISABLED)",
          "required": true
        },
        {
          "name": "activeDecisionUseBlocked",
          "type": "boolean",
          "required": true,
          "notes": "Always true upon verification expiry."
        }
      ]
    },
    {
      "name": "verification.refreshed",
      "description": "A provider operation verification was refreshed; active decision use restores only when both official-doc AND live-contract verifications succeed (AC-270).",
      "requirementRefs": ["FR-PROV-002", "FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "kind",
          "type": "string(DOCUMENTATION|PRICING_PLAN|QUOTA|RIGHTS|SCHEMA|ENDPOINT|AUTHENTICATION|DEPRECATION|LIVE_PROBE)",
          "required": true
        },
        {
          "name": "source",
          "type": "string(OFFICIAL_DOC|LIVE_CONTRACT)",
          "required": true
        },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "verifiedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "expiresAt", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "activeDecisionUseRestored",
          "type": "boolean",
          "required": true,
          "notes": "True only when both official-doc and live-contract verifications are fresh."
        }
      ]
    },
    {
      "name": "deprecation.detected",
      "description": "A provider operation deprecation was detected or registered, blocking new feature dependency registrations without an approved migration exception (FR-PROV-003).",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "deprecatedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "sunsetAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "replacementOperationId", "type": "string|null", "required": true },
        { "name": "affectedFeatureCount", "type": "integer", "required": true },
        { "name": "detectedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "sunset.incident.raised",
      "description": "A sunset date or official deprecation notice raised a tracked security/operational incident with a migration deadline (FR-PROV-003).",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "sunsetAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "migrationDeadline", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "incidentId",
          "type": "string",
          "required": true,
          "notes": "Created through the security incidents API."
        },
        { "name": "raisedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "migration_exception.granted",
      "description": "A time-bounded migration exception with an approved replacement plan was granted for a deprecated provider operation (FR-PROV-003).",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "exceptionId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "approver", "type": "string", "required": true },
        { "name": "replacementPlanRef", "type": "string", "required": true },
        { "name": "grantedAt", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "expiresAt",
          "type": "string<utc-timestamp>",
          "required": true,
          "notes": "Time-bounded expiry instant; fail-closed re-blocking occurs when reached."
        }
      ]
    },
    {
      "name": "migration_exception.expired",
      "description": "A migration exception expired, automatically re-blocking new implementations from using the deprecated operation (FR-PROV-003 fail-closed).",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "exceptionId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "expiredAt", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "useReblocked",
          "type": "boolean",
          "required": true,
          "notes": "Always true upon exception expiry."
        }
      ]
    },
    {
      "name": "response.quarantined",
      "description": "A provider response containing transaction payloads, signing requests, executable instructions, private-key fields, or unexpected write capability was rejected, quarantined, audited, and excluded from model context (FR-PROV-008).",
      "requirementRefs": ["FR-PROV-008"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "quarantineId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "detectedClasses",
          "type": "array<string(TRANSACTION_PAYLOAD|SIGNING_REQUEST|EXECUTABLE_INSTRUCTION|PRIVATE_KEY_FIELD|UNEXPECTED_WRITE_CAPABILITY)>",
          "required": true
        },
        { "name": "fieldPaths", "type": "array<string>", "required": true },
        {
          "name": "payloadSha256",
          "type": "string",
          "required": true,
          "notes": "sha256:<hex> hash of raw response bytes — never the hazardous payload material itself."
        },
        { "name": "byteSize", "type": "integer", "required": true },
        { "name": "disposition", "type": "string(REJECTED)", "required": true },
        { "name": "modelContextExclusion", "type": "string(ENFORCED)", "required": true },
        { "name": "auditChainRef", "type": "string", "required": true },
        { "name": "quarantinedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.changed",
      "description": "A provider data rights declaration changed between versions, computing newly prohibited uses across storage, derived use, redistribution, caching, and export paths (FR-PROV-009).",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "fromRightsVersion", "type": "string", "required": true },
        { "name": "toRightsVersion", "type": "string", "required": true },
        { "name": "termsVersion", "type": "string", "required": true },
        {
          "name": "newlyProhibitedUses",
          "type": "array<string(STORAGE|DERIVED_FEATURES|REDISTRIBUTION|CACHE|RAW_EXPORT|MODEL_TRAINING|PUBLIC_ALERT_DERIVATIVE|COMMERCIAL_USE)>",
          "required": true
        },
        { "name": "affectedArtifactCount", "type": "integer", "required": true },
        { "name": "changedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.use_blocked",
      "description": "A provider data access path or derived use was refused fail-closed due to updated rights policy restrictions or unverified rights (FR-PROV-009).",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "requestedUse",
          "type": "string(STORAGE|DERIVED_FEATURES|REDISTRIBUTION|CACHE|RAW_EXPORT|MODEL_TRAINING|PUBLIC_ALERT_DERIVATIVE|COMMERCIAL_USE)",
          "required": true
        },
        {
          "name": "reason",
          "type": "string(RIGHTS_RESTRICTED|RIGHTS_UNVERIFIED|VERIFICATION_EXPIRED|TERMS_VERSION_MISMATCH|JURISDICTION_PROHIBITED|BYOK_REQUIRED)",
          "required": true
        },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.action_executed",
      "description": "A durable quarantine or retirement action was executed against a previously stored provider artifact following a rights tightening change (FR-PROV-009).",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "actionId", "type": "string", "required": true },
        { "name": "changeId", "type": "string", "required": true },
        { "name": "artifactRef", "type": "string", "required": true },
        { "name": "action", "type": "string(QUARANTINE|RETIRE)", "required": true },
        { "name": "reason", "type": "string", "required": true },
        { "name": "executedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "readiness.blocked",
      "description": "Provider-side activation readiness reported BLOCKED due to unverified rights, expired verification, unhandled deprecation, or prohibited capability exposure.",
      "requirementRefs": [
        "FR-PROV-001",
        "FR-PROV-002",
        "FR-PROV-003",
        "FR-PROV-009",
        "FR-PROV-010"
      ],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "readiness", "type": "string(BLOCKED)", "required": true },
        {
          "name": "reasons",
          "type": "array<string(RIGHTS_UNVERIFIED|VERIFICATION_EXPIRED|DEPRECATED_WITHOUT_EXCEPTION|PROHIBITED_CAPABILITY_EXPOSED|HEALTH_DEGRADED|LIFECYCLE_NOT_ACTIVE)>",
          "required": true
        },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "fingerprint.captured",
      "description": "A provider source fingerprint was captured and stored for empirical dependence and lineage analysis (FR-PROV-010).",
      "requirementRefs": ["FR-PROV-010"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "fingerprintId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "kind",
          "type": "string(UPSTREAM_LINEAGE|VALUE_CORRELATION|TIMING_BEHAVIOR|OUTAGE_CORRELATION|SCHEMA_CHARACTERISTICS|FIRST_SEEN_BEHAVIOR)",
          "required": true
        },
        {
          "name": "fingerprintSha256",
          "type": "string",
          "required": true,
          "notes": "sha256:<hex> of canonical JSON fingerprint structure."
        },
        { "name": "estimatorInputRefs", "type": "array<string>", "required": true },
        { "name": "capturedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    }
  ]
}
