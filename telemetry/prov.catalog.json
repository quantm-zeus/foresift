{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "prov",
  "description": "Provider-lifecycle telemetry events for operation registration, lifecycle state transitions and refusals, verification expiry and refreshes, deprecation detection and sunset incidents, migration exception lifecycle, response quarantine, rights changes/refusals/actions, readiness gating, and source fingerprints. Every refusal event carries its typed machine reason; no event ever carries secret material, unredacted hazardous payloads, private keys, or credentials.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — this file defines the event contracts the requirement manifest maps to (telemetry/prov.*); emitter wiring lands with the observability milestone (dependency group G2), so nothing publishes these event names yet. Field lists mirror the authoritative schemas in packages/shared-schemas/src/prov.ts exactly.",
  "requirementsCovered": [
    "FR-PROV-001",
    "FR-PROV-002",
    "FR-PROV-003",
    "FR-PROV-008",
    "FR-PROV-009",
    "FR-PROV-010"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "operation.registered",
      "description": "A provider operation definition was registered in the authoritative operation registry with its capability class, supported chains/programs, cost class, schemas, and policy bindings.",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "capabilityClass",
          "type": "string(READ_MARKET|READ_SECURITY|READ_IDENTITY|READ_TRANSACTION_RAW|READ_TRANSACTION_HISTORY|READ_ACCOUNT_STATE|READ_SOCIAL_AGGREGATE|STREAM_PROGRAM_EVENT|QUOTE_READ_ONLY)",
          "required": true,
          "notes": "Prohibited capability classes (PROHIBITED_TRANSACTION_BUILD, PROHIBITED_SIGN, PROHIBITED_SUBMIT, PROHIBITED_CUSTODY) are refused at registration."
        },
        {
          "name": "costClass",
          "type": "string(FREE_UNMETERED|FREE_QUOTA|PAID_EXPLICIT|UNKNOWN_COST|DISABLED)",
          "required": true
        },
        {
          "name": "healthStatus",
          "type": "string(HEALTHY|DEGRADED|SCHEMA_DRIFT|PLAN_UNVERIFIED|RIGHTS_UNVERIFIED|DEPRECATED|SUNSET_PENDING|QUOTA_LOW|QUOTA_EXHAUSTED|AUTH_FAILED|UNSUPPORTED|DISABLED)",
          "required": true
        },
        { "name": "supportedChains", "type": "array<string>", "required": true },
        { "name": "inputSchemaId", "type": "string", "required": true },
        { "name": "rawOutputSchemaId", "type": "string", "required": true },
        { "name": "normalizedOutputSchemaId", "type": "string", "required": true },
        { "name": "allowedInStrictFree", "type": "boolean", "required": true },
        { "name": "declaredIndependenceGroup", "type": "string", "required": true },
        { "name": "registeredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "lifecycle.transitioned",
      "description": "A provider operation underwent a guarded state transition recorded on the append-only immutable lifecycle events ledger.",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "fromState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "toState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "reasonClass",
          "type": "string(DISCOVERY_INGESTION|INITIAL_VERIFICATION_PASSED|TTL_EXPIRY|LIVE_PROBE_FAILED|LIVE_PROBE_RESTORED|DEPRECATION_ANNOUNCED|SUNSET_REACHED|SECURITY_QUARANTINE|RIGHTS_TIGHTENED|OPERATOR_BLOCKED|RETIRED_PERMANENTLY)",
          "required": true
        },
        { "name": "actor", "type": "string", "required": true },
        {
          "name": "idempotencyKey",
          "type": "string",
          "required": true,
          "notes": "Unique transition idempotency key; fences retries from double-appending."
        },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "occurredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "lifecycle.refused",
      "description": "A requested lifecycle transition was refused because it violated the legal state machine graph, lacked required proofs, or attempted prohibited capability activation.",
      "requirementRefs": ["FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "currentState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "attemptedState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        {
          "name": "refusalReason",
          "type": "string(ILLEGAL_TRANSITION|VERIFICATION_INSUFFICIENT|DUAL_PROOF_MISSING|PROHIBITED_CAPABILITY|IDEMPOTENCY_COLLISION|REASON_MISSING|MIGRATION_EXCEPTION_LAPSED)",
          "required": true
        },
        { "name": "missingRequirements", "type": "array<string>", "required": true },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "verification.expired",
      "description": "A configured verification TTL elapsed for an operation, moving it out of active decision use and transitioning its health/lifecycle state until reverified.",
      "requirementRefs": ["FR-PROV-002", "FR-PROV-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "kind",
          "type": "string(DOCUMENTATION|PRICING_PLAN|QUOTA|RIGHTS|SCHEMA|ENDPOINT|AUTHENTICATION|DEPRECATION|LIVE_PROBE)",
          "required": true
        },
        { "name": "verifiedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "expiresAt", "type": "string<utc-timestamp>", "required": true },
        {
          "name": "resultingHealthStatus",
          "type": "string(PLAN_UNVERIFIED|RIGHTS_UNVERIFIED|DEGRADED|SCHEMA_DRIFT|AUTH_FAILED|DISABLED)",
          "required": true
        },
        {
          "name": "resultingLifecycleState",
          "type": "string(DISCOVERED|VERIFIED|ACTIVE|DEGRADED|DEPRECATED|BLOCKED|REMOVED)",
          "required": true
        },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "verification.refreshed",
      "description": "A verification record was recorded with evidence references; satisfying the AC-270 dual-source requirement (OFFICIAL_DOC + LIVE_CONTRACT within TTL) enables active decision use.",
      "requirementRefs": ["FR-PROV-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "verificationId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "kind",
          "type": "string(DOCUMENTATION|PRICING_PLAN|QUOTA|RIGHTS|SCHEMA|ENDPOINT|AUTHENTICATION|DEPRECATION|LIVE_PROBE)",
          "required": true
        },
        {
          "name": "source",
          "type": "string(OFFICIAL_DOC|LIVE_CONTRACT)",
          "required": true
        },
        {
          "name": "outcome",
          "type": "string(PASSED|FAILED)",
          "required": true
        },
        { "name": "evidenceRefs", "type": "array<string>", "required": true },
        { "name": "ttlSeconds", "type": "integer", "required": true },
        { "name": "verifiedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "expiresAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "deprecation.detected",
      "description": "An official deprecation notice, vendor communication, or documentation update marked a provider operation deprecated, blocking new feature implementations without an approved exception.",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "deprecatedAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "sunsetAt", "type": "string<utc-timestamp>|null", "required": true },
        { "name": "replacementOperationId", "type": "string|null", "required": true },
        { "name": "affectedFeatureCount", "type": "integer", "required": true },
        { "name": "isSoleCriticalSource", "type": "boolean", "required": true },
        { "name": "detectedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "sunset.incident_raised",
      "description": "A sunset date or formal deprecation notice raised a tracked security/operational incident with a required migration deadline.",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "incidentId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "sunsetAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "migrationDeadline", "type": "string<utc-timestamp>", "required": true },
        { "name": "replacementOperationId", "type": "string|null", "required": true },
        { "name": "affectedFeatures", "type": "array<string>", "required": true },
        { "name": "raisedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "migration_exception.granted",
      "description": "A time-bounded migration exception was granted with an approved replacement plan and approver signature, allowing temporary maintenance use of a deprecated operation.",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "exceptionId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        { "name": "approver", "type": "string", "required": true },
        { "name": "replacementPlanRef", "type": "string", "required": true },
        { "name": "exceptionExpiresAt", "type": "string<utc-timestamp>", "required": true },
        { "name": "grantedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "migration_exception.expired",
      "description": "A migration exception reached its expiration timestamp or was revoked; new implementation use re-blocks immediately and fail-closed.",
      "requirementRefs": ["FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "exceptionId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "reason",
          "type": "string(TTL_EXPIRED|MANUALLY_REVOKED)",
          "required": true
        },
        { "name": "expiredAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "response.quarantined",
      "description": "A provider response contained forbidden material (transaction payload, signing request, executable instruction, private-key field, or unexpected write capability); response was rejected, quarantined (metadata-only; no payload bytes persisted), audited, and excluded from model context.",
      "requirementRefs": ["FR-PROV-008"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "quarantineId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "detectedClasses",
          "type": "array<string(TRANSACTION_PAYLOAD|SIGNING_REQUEST|EXECUTABLE_INSTRUCTION|PRIVATE_KEY_FIELD|UNEXPECTED_WRITE_CAPABILITY)>",
          "required": true
        },
        { "name": "fieldPaths", "type": "array<string>", "required": true },
        {
          "name": "payloadSha256",
          "type": "string",
          "required": true,
          "notes": "sha256:<hex> keyed hash of the rejected payload — never the raw payload itself."
        },
        { "name": "byteSize", "type": "integer", "required": true },
        {
          "name": "disposition",
          "type": "string(REJECTED)",
          "required": true
        },
        {
          "name": "modelContextExclusion",
          "type": "string(ENFORCED)",
          "required": true
        },
        { "name": "auditEntrySeq", "type": "integer", "required": true },
        { "name": "quarantinedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.changed",
      "description": "A provider data-rights matrix declaration changed; newly prohibited uses across storage, derived use, redistribution, caching, and export paths fail closed immediately.",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "fromRightsVersion", "type": "integer", "required": true },
        { "name": "toRightsVersion", "type": "integer", "required": true },
        { "name": "termsVersion", "type": "string", "required": true },
        {
          "name": "newlyProhibitedUses",
          "type": "array<string(COMMERCIAL_USE|PERSONAL_RESEARCH|CACHE|RAW_RETENTION|DERIVED_FEATURES|MODEL_TRAINING|REDISTRIBUTION|PUBLIC_ALERT_DERIVATIVE|RAW_EXPORT)>",
          "required": true
        },
        { "name": "affectedArtifactCount", "type": "integer", "required": true },
        { "name": "changedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.use_blocked",
      "description": "An attempt to cache, retain, export, redistribute, or use provider-derived data in model context was blocked fail-closed due to rights restrictions or unverified rights.",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "rightsVersion", "type": "integer", "required": true },
        {
          "name": "attemptedPath",
          "type": "string(CACHE|RAW_RETENTION|RAW_EXPORT|REDISTRIBUTION|MODEL_TRAINING|DERIVED_FEATURES|PUBLIC_ALERT_DERIVATIVE|COMMERCIAL_USE)",
          "required": true
        },
        {
          "name": "refusalReason",
          "type": "string(RIGHTS_PROHIBITED|RIGHTS_UNVERIFIED|VERIFICATION_EXPIRED|TERMS_MISMATCH|JURISDICTION_RESTRICTED|USER_BYOK_MISSING)",
          "required": true
        },
        { "name": "consumer", "type": "string", "required": true },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "rights.action_executed",
      "description": "A remediation action (quarantine or retirement) was executed against an existing stored artifact following a data-rights matrix tightening.",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "actionId", "type": "string", "required": true },
        { "name": "changeId", "type": "string", "required": true },
        { "name": "artifactId", "type": "string", "required": true },
        { "name": "objectRef", "type": "string", "required": true },
        {
          "name": "action",
          "type": "string(QUARANTINE|RETIRE)",
          "required": true
        },
        { "name": "executedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "readiness.blocked",
      "description": "Provider-side readiness evaluation refused activation because rights verification, lifecycle state, verification freshness, migration exceptions, or adapter allowlists failed policy.",
      "requirementRefs": ["FR-PROV-009", "FR-PROV-001", "FR-PROV-002", "FR-PROV-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        {
          "name": "providerId",
          "type": "string",
          "required": true
        },
        {
          "name": "operationId",
          "type": "string|null",
          "required": true,
          "notes": "Null for provider-wide readiness evaluation."
        },
        {
          "name": "verdict",
          "type": "string(BLOCKED)",
          "required": true
        },
        {
          "name": "blockingReasons",
          "type": "array<string(RIGHTS_UNVERIFIED|RIGHTS_EXPIRED|LIFECYCLE_NOT_ACTIVE|VERIFICATION_EXPIRED|DEPRECATED_WITHOUT_EXCEPTION|PROHIBITED_CAPABILITY_EXPOSED|ALLOWLIST_INCOMPLETE|HEALTH_DEGRADED)>",
          "required": true
        },
        { "name": "evaluatedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "fingerprint.captured",
      "description": "A provider source fingerprint was computed and recorded for empirical dependence and lineage analysis.",
      "requirementRefs": ["FR-PROV-010"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "fingerprintId", "type": "string", "required": true },
        { "name": "providerId", "type": "string", "required": true },
        { "name": "operationId", "type": "string", "required": true },
        { "name": "version", "type": "string", "required": true },
        {
          "name": "fingerprintKind",
          "type": "string(UPSTREAM_LINEAGE|VALUE_CORRELATION|TIMING_BEHAVIOR|OUTAGE_CORRELATION|SCHEMA_CHARACTERISTICS|FIRST_SEEN_BEHAVIOR)",
          "required": true
        },
        {
          "name": "fingerprintPayloadSha256",
          "type": "string",
          "required": true,
          "notes": "sha256:<hex> of canonical JSON fingerprint structure."
        },
        { "name": "estimatorInputRefs", "type": "array<string>", "required": true },
        { "name": "computedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    }
  ]
}
