          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "required": true
        },
        {
          "name": "blockedAt",
          "type": "string<utc-timestamp>",
          "required": true
        }
      ]
    },
    {
      "name": "rights.action_executed",
      "description": "A quarantine or retirement action was executed against previously stored restricted artifacts following a rights policy change.",
      "requirementRefs": ["FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        {
          "name": "actionId",
          "type": "string",
          "required": true
        },
        {
          "name": "changeId",
          "type": "string",
          "required": true
        },
        {
          "name": "artifactId",
          "type": "string",
          "required": true
        },
        {
          "name": "providerId",
          "type": "string",
          "required": true
        },
        {
          "name": "operationId",
          "type": "string",
          "required": true
        },
        {
          "name": "action",
          "type": "string(QUARANTINE|RETIRE)",
          "required": true
        },
        {
          "name": "executedAt",
          "type": "string<utc-timestamp>",
          "required": true
        }
      ]
    },
    {
      "name": "readiness.blocked",
      "description": "Provider activation readiness evaluation reported BLOCKED due to unverified rights, expired verification, deprecated operation without exception, or prohibited exposure.",
      "requirementRefs": ["FR-PROV-001", "FR-PROV-002", "FR-PROV-003", "FR-PROV-009"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        {
          "name": "providerId",
          "type": "string",
          "required": true
        },
        {
          "name": "operationId",
          "type": "string",
          "required": true
        },
        {
          "name": "version",
          "type": "string",
          "required": true
        },
        {
          "name": "verdict",
          "type": "string(BLOCKED)",
          "required": true
        },
        {
          "name": "reasons",
          "type": "array<string(RIGHTS_UNVERIFIED|VERIFICATION_EXPIRED|DEPRECATED_WITHOUT_EXCEPTION|PROHIBITED_CAPABILITY_EXPOSED|HEALTH_DEGRADED|LIFECYCLE_NOT_ACTIVE)>",
          "required": true
        },
        {
          "name": "evaluatedAt",
          "type": "string<utc-timestamp>",
          "required": true
