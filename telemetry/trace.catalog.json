{
  "$schema": "https://foresift.dev/schemas/telemetry-catalog-v1.json",
  "catalog": "trace",
  "description": "Traceability and release-conformance contracts. Event names are emitted under the trace.* namespace.",
  "contractStatus": "DECLARATIVE_CONTRACT_ONLY — emitter wiring lands with dependency group G2.",
  "requirementsCovered": [
    "FR-TRACE-001",
    "FR-TRACE-002",
    "FR-TRACE-003",
    "FR-TRACE-004",
    "FR-TRACE-005",
    "FR-TRACE-006"
  ],
  "recoveryDataClass": "CRITICAL_METADATA",
  "events": [
    {
      "name": "manifest.integrity_checked",
      "description": "The authoritative manifest artifact set was integrity checked.",
      "requirementRefs": ["FR-TRACE-001"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "manifestSha256", "type": "string<sha256>", "required": true },
        { "name": "verdict", "type": "string(PASS|REFUSED)", "required": true },
        { "name": "checkedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "ids.superseded",
      "description": "A stable identifier was explicitly superseded.",
      "requirementRefs": ["FR-TRACE-002"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "replacedId", "type": "string", "required": true },
        { "name": "replacementId", "type": "string", "required": true },
        { "name": "recordedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "conformance.finding",
      "description": "A release-blocking conformance finding was detected.",
      "requirementRefs": ["FR-TRACE-003"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "requirementId", "type": "string", "required": true },
        { "name": "rule", "type": "string", "required": true },
        { "name": "path", "type": "string", "required": true },
        { "name": "foundAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "gate.evidence_recorded",
      "description": "Signed and hashed gate evidence was recorded.",
      "requirementRefs": ["FR-TRACE-004"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "evidenceId", "type": "string", "required": true },
        { "name": "artifactSha256", "type": "string<sha256>", "required": true },
        { "name": "recordedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "gate.evidence_refused",
      "description": "Gate evidence was refused with a typed reason.",
      "requirementRefs": ["FR-TRACE-004"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "evidenceId", "type": "string", "required": true },
        { "name": "reason", "type": "string", "required": true },
        { "name": "refusedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "decision.trace_recorded",
      "description": "A content-addressed production decision trace was recorded.",
      "requirementRefs": ["FR-TRACE-005"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "traceId", "type": "string<sha256>", "required": true },
        { "name": "decisionRef", "type": "string", "required": true },
        { "name": "recordedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    },
    {
      "name": "release.report_emitted",
      "description": "A deterministic release-conformance report was emitted.",
      "requirementRefs": ["FR-TRACE-006"],
      "tier": "CRITICAL_METADATA",
      "fields": [
        { "name": "reportId", "type": "string", "required": true },
        { "name": "reportSha256", "type": "string<sha256>", "required": true },
        { "name": "emittedAt", "type": "string<utc-timestamp>", "required": true }
      ]
    }
  ]
}
