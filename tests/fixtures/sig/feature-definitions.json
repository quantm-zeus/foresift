{
  "schema": "foresift/sig-feature-definitions@1",
  "validNumericDefinitions": [
    {
      "featureId": "sig:h1_volume_acceleration:v1",
      "version": 1,
      "description": "H.1 Short-term volume acceleration vs trailing baseline",
      "formula": "log1p(v_5m) - log1p(mean(v_5m_trailing_12))",
      "inputFields": ["swaps.volume_usd", "swaps.event_at"],
      "unit": "log_ratio",
      "windows": ["5m", "1h"],
      "minimumObservations": 3,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "WINSORIZE_99TH_PERCENTILE",
      "updatePolicy": "ON_NEW_ECONOMIC_TRADE",
      "freshnessLimitSeconds": 300,
      "cohortDefinitionId": "cohort:solana:liquidity_tier",
      "evidenceRequirements": ["FIRST_PARTY_TRADE_RECEIPT"],
      "minimumDenominator": 3,
      "isNumeric": true,
      "stabilityTransform": "LOG1P",
      "shrinkagePolicy": "EMPIRICAL_BAYES_SHRINK_TO_COHORT_PRIOR",
      "cappedContribution": 0.25,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h2_volume_persistence:v1",
      "version": 1,
      "description": "H.2 Multi-window volume persistence ratio",
      "formula": "count(populated_5m_buckets_with_activity) / total_window_buckets",
      "inputFields": ["swaps.volume_usd", "swaps.event_at"],
      "unit": "ratio",
      "windows": ["1h", "4h"],
      "minimumObservations": 12,
      "nullPolicy": "ZERO_IMPUTED_WITH_LOW_SAMPLE",
      "outlierPolicy": "CLAMP_0_TO_1",
      "updatePolicy": "ON_BUCKET_CLOSE",
      "freshnessLimitSeconds": 300,
      "cohortDefinitionId": "cohort:solana:age_band",
      "evidenceRequirements": ["FIRST_PARTY_TRADE_RECEIPT"],
      "minimumDenominator": 12,
      "isNumeric": true,
      "stabilityTransform": "LINEAR_RATIO",
      "shrinkagePolicy": "SHRINK_TO_PRIOR_0_5",
      "cappedContribution": 0.20,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h3_price_extension:v1",
      "version": 1,
      "description": "H.3 Price extension beyond moving average baseline",
      "formula": "(p_current - p_ma_1h) / max(p_ma_1h, epsilon)",
      "inputFields": ["swaps.price_usd", "swaps.event_at"],
      "unit": "ratio",
      "windows": ["1h"],
      "minimumObservations": 5,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "WINSORIZE_ROBUST_MAD",
      "updatePolicy": "ON_PRICE_UPDATE",
      "freshnessLimitSeconds": 60,
      "cohortDefinitionId": "cohort:solana:market_cap_tier",
      "evidenceRequirements": ["ORACLE_PRICE_OBSERVATION"],
      "minimumDenominator": 5,
      "isNumeric": true,
      "stabilityTransform": "LOG1P_DIFFERENCE",
      "shrinkagePolicy": "SHRINK_TO_ZERO",
      "cappedContribution": 0.15,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": false
    },
    {
      "featureId": "sig:h4_unique_buyer_growth:v1",
      "version": 1,
      "description": "H.4 Deduplicated unique economic buyer log growth",
      "formula": "log1p(count(distinct_dedup_economic_buyers_t)) - log1p(count(distinct_dedup_economic_buyers_t_prev))",
      "inputFields": ["swaps.buyer_address", "economic_actors.cluster_id", "economic_actors.confidence"],
      "unit": "log_growth",
      "windows": ["1h", "24h"],
      "minimumObservations": 10,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "WINSORIZE_99TH_PERCENTILE",
      "updatePolicy": "ON_BUYER_CLUSTER_RESOLVED",
      "freshnessLimitSeconds": 600,
      "cohortDefinitionId": "cohort:solana:launchpad_and_chain",
      "evidenceRequirements": ["ACTOR_RESOLUTION_RECEIPT"],
      "minimumDenominator": 10,
      "isNumeric": true,
      "stabilityTransform": "LOG1P",
      "shrinkagePolicy": "EMPIRICAL_BAYES_SHRINK_TO_COHORT_PRIOR",
      "cappedContribution": 0.30,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h5_buysell_imbalance:v1",
      "version": 1,
      "description": "H.5 Net buy volume vs sell volume imbalance",
      "formula": "(buy_volume_usd - sell_volume_usd) / (buy_volume_usd + sell_volume_usd + epsilon)",
      "inputFields": ["swaps.side", "swaps.volume_usd"],
      "unit": "imbalance_ratio",
      "windows": ["15m", "1h"],
      "minimumObservations": 4,
      "nullPolicy": "ZERO_IMPUTED_WITH_LOW_SAMPLE",
      "outlierPolicy": "CLAMP_NEG1_TO_POS1",
      "updatePolicy": "ON_NEW_ECONOMIC_TRADE",
      "freshnessLimitSeconds": 180,
      "cohortDefinitionId": "cohort:solana:liquidity_tier",
      "evidenceRequirements": ["FIRST_PARTY_TRADE_RECEIPT"],
      "minimumDenominator": 4,
      "isNumeric": true,
      "stabilityTransform": "BOUNDED_RATIO",
      "shrinkagePolicy": "SHRINK_TO_ZERO",
      "cappedContribution": 0.20,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h6_liquidity_growth:v1",
      "version": 1,
      "description": "H.6 Canonical pool reserves net change",
      "formula": "(reserves_t - reserves_t0) / reserves_t0",
      "inputFields": ["pools.reserves_usd", "pools.slot"],
      "unit": "growth_ratio",
      "windows": ["1h", "24h"],
      "minimumObservations": 2,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "WINSORIZE_ROBUST_MAD",
      "updatePolicy": "ON_SLOT_STATE_CHANGE",
      "freshnessLimitSeconds": 300,
      "cohortDefinitionId": "cohort:solana:liquidity_tier",
      "evidenceRequirements": ["CANONICAL_POOL_STATE"],
      "minimumDenominator": 2,
      "isNumeric": true,
      "stabilityTransform": "LOG1P_CHANGE",
      "shrinkagePolicy": "SHRINK_TO_ZERO",
      "cappedContribution": 0.15,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": false
    },
    {
      "featureId": "sig:h7_top10_concentration_slope:v1",
      "version": 1,
      "description": "H.7 Rate of change of top-10 holder supply share",
      "formula": "(top10_share_t - top10_share_t_prev) / delta_hours",
      "inputFields": ["token_accounts.balance", "token_accounts.owner", "supply.circulating"],
      "unit": "share_delta_per_hour",
      "windows": ["4h", "24h"],
      "minimumObservations": 2,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "CLAMP_NEG1_TO_POS1",
      "updatePolicy": "ON_SNAPSHOT",
      "freshnessLimitSeconds": 1800,
      "cohortDefinitionId": "cohort:solana:market_cap_tier",
      "evidenceRequirements": ["SUPPLY_DISTRIBUTION_SNAPSHOT"],
      "minimumDenominator": 2,
      "isNumeric": true,
      "stabilityTransform": "LINEAR_DELTA",
      "shrinkagePolicy": "SHRINK_TO_ZERO",
      "cappedContribution": 0.20,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": false
    },
    {
      "featureId": "sig:h8_holder_log_growth:v1",
      "version": 1,
      "description": "H.8 Log growth in total non-zero holder accounts",
      "formula": "log1p(holders_t) - log1p(holders_t_prev)",
      "inputFields": ["token_accounts.count", "token_accounts.timestamp"],
      "unit": "log_growth",
      "windows": ["4h", "24h"],
      "minimumObservations": 2,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "WINSORIZE_99TH_PERCENTILE",
      "updatePolicy": "ON_SNAPSHOT",
      "freshnessLimitSeconds": 1800,
      "cohortDefinitionId": "cohort:solana:age_band",
      "evidenceRequirements": ["SUPPLY_DISTRIBUTION_SNAPSHOT"],
      "minimumDenominator": 2,
      "isNumeric": true,
      "stabilityTransform": "LOG1P",
      "shrinkagePolicy": "SHRINK_TO_COHORT_MEAN",
      "cappedContribution": 0.15,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": false
    },
    {
      "featureId": "sig:h9_tradesize_entropy:v1",
      "version": 1,
      "description": "H.9 Normalized Shannon entropy of trade size distribution",
      "formula": "-sum(p_i * log2(p_i)) / log2(k_bins)",
      "inputFields": ["swaps.volume_usd", "swaps.event_at"],
      "unit": "normalized_entropy",
      "windows": ["1h"],
      "minimumObservations": 8,
      "nullPolicy": "NULL_WITH_LOW_SAMPLE",
      "outlierPolicy": "CLAMP_0_TO_1",
      "updatePolicy": "ON_NEW_ECONOMIC_TRADE",
      "freshnessLimitSeconds": 300,
      "cohortDefinitionId": "cohort:solana:liquidity_tier",
      "evidenceRequirements": ["FIRST_PARTY_TRADE_RECEIPT"],
      "minimumDenominator": 8,
      "isNumeric": true,
      "stabilityTransform": "BOUNDED_0_1",
      "shrinkagePolicy": "SHRINK_TO_PRIOR_0_5",
      "cappedContribution": 0.15,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h10_manipulation_indicators:v1",
      "version": 1,
      "description": "H.10 Composite score of shared funder, round-trip and actor volume concentration",
      "formula": "0.4 * shared_funder_ratio + 0.3 * round_trip_ratio + 0.3 * top_actor_volume_share",
      "inputFields": ["actor_funding.shared_funder_ratio", "trades.round_trip_ratio", "trades.actor_volume_concentration"],
      "unit": "risk_composite_score",
      "windows": ["1h", "4h"],
      "minimumObservations": 5,
      "nullPolicy": "NULL_WITH_QUALITY_CODE",
      "outlierPolicy": "CLAMP_0_TO_1",
      "updatePolicy": "ON_ACTOR_METRICS_UPDATE",
      "freshnessLimitSeconds": 600,
      "cohortDefinitionId": "cohort:solana:launchpad_and_chain",
      "evidenceRequirements": ["ACTOR_FUNDING_GRAPH_RECEIPT", "TRADE_ROUNDTRIP_ANALYSIS"],
      "minimumDenominator": 5,
      "isNumeric": true,
      "stabilityTransform": "BOUNDED_0_1",
      "shrinkagePolicy": "CONSERVATIVE_UPPER_BOUND",
      "cappedContribution": 0.35,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h11_robust_activity_changepoint:v1",
      "version": 1,
      "description": "H.11 Robust median/MAD activity z-score and EWMA/CUSUM change-point emergence",
      "formula": "S_t = max(0, S_{t-1} + (v_t - median) / (1.4826 * MAD + epsilon) - drift_allowance)",
      "inputFields": ["swaps.volume_usd", "swaps.event_at", "swaps.count"],
      "unit": "cusum_statistic",
      "windows": ["5m", "1h", "6h"],
      "minimumObservations": 12,
      "nullPolicy": "NULL_WITH_LOW_SAMPLE",
      "outlierPolicy": "ROBUST_MEDIAN_MAD_Z_SCORE",
      "updatePolicy": "ON_BUCKET_CLOSE",
      "freshnessLimitSeconds": 300,
      "cohortDefinitionId": "cohort:solana:age_band",
      "evidenceRequirements": ["FIRST_PARTY_TRADE_RECEIPT"],
      "minimumDenominator": 12,
      "isNumeric": true,
      "stabilityTransform": "LOG1P_ROBUST_Z",
      "shrinkagePolicy": "SHRINK_TO_ZERO",
      "cappedContribution": 0.30,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": true
    },
    {
      "featureId": "sig:h12_data_coverage:v1",
      "version": 1,
      "description": "H.12 Window observation coverage fraction and source freshness weight",
      "formula": "sum(populated_window_seconds) / expected_window_seconds",
      "inputFields": ["collector.stream_receipts", "collector.gaps"],
      "unit": "coverage_fraction",
      "windows": ["1h", "24h"],
      "minimumObservations": 1,
      "nullPolicy": "ZERO_IMPUTED_WITH_QUALITY_CODE",
      "outlierPolicy": "CLAMP_0_TO_1",
      "updatePolicy": "ON_WINDOW_CHECK",
      "freshnessLimitSeconds": 120,
      "cohortDefinitionId": "cohort:solana:chain_wide",
      "evidenceRequirements": ["COLLECTOR_HEALTH_RECEIPT"],
      "minimumDenominator": 1,
      "isNumeric": true,
      "stabilityTransform": "BOUNDED_0_1",
      "shrinkagePolicy": "CONSERVATIVE_LOWER_BOUND",
      "cappedContribution": 0.10,
      "outlierPolicyIsRobust": true,
      "cohortFallbackPolicyId": "fallback:standard_7_level",
      "economicEventRequired": false
    }
  ],
